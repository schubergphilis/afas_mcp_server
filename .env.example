# Copy this file to .env and fill in your values. Never commit .env: it holds the token.

# The number in your AFAS Online URL, e.g. https://12345.afasonline.com -> 12345
AFAS_MEMBER_ID=12345

# The app connector token. Paste the full XML, only the <data> value, or the base64 form; all three work.
AFAS_TOKEN=<token><version>1</version><data>YOUR_TOKEN_DATA</data></token>

# production (default), test or accept. Selects rest / resttest / restaccept in the hostname.
AFAS_ENVIRONMENT=production

# Optional: full REST base URL. Overrides AFAS_MEMBER_ID and AFAS_ENVIRONMENT, e.g. for a proxy.
# AFAS_BASE_URL=https://12345.rest.afas.online/profitrestservices

# Register the insert, update and delete tools. Off by default: the server is read-only.
AFAS_ALLOW_WRITES=false

# HTTP timeout per AFAS call, in seconds.
AFAS_TIMEOUT_SECONDS=60

# Rows per page when a tool call does not give a take, and the largest take a tool call may request.
AFAS_DEFAULT_TAKE=100
AFAS_MAX_TAKE=1000

# Language of AFAS messages: nl-nl, nl-be, fr-fr, de-de or en-us.
AFAS_LANGUAGE=nl-nl

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stderr.
AFAS_LOG_LEVEL=INFO
